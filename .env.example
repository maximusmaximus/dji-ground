# ==============================================================================
# dji-ground configuration template
#   cp .env.example .env      (then edit; .env is git-ignored, never commit it)
#   uv run dji-station --check    verifies everything below
# Relative paths are resolved against the repo root, so any working directory works.
# Placeholder values that start with "your_" are treated as "not set".
# ==============================================================================

# --- Bridge -------------------------------------------------------------------
# fake    = built-in simulator (no aircraft needed)
# opendji = OpenDJI app on an Android phone USB-attached to the RC, ports forwarded with:
#           adb forward tcp:8001 tcp:8001 ; adb forward tcp:8002 tcp:8002 ; adb forward tcp:8003 tcp:8003
DJI_BRIDGE_MODE=fake
DJI_BRIDGE_HOST=127.0.0.1
DJI_TELEMETRY_PORT=8001
DJI_VIDEO_PORT=8002
DJI_COMMAND_PORT=8003
DJI_BRIDGE_RECONNECT_S=3

# --- Gateway (web UI + REST + MCP at /mcp) -------------------------------------
DJI_GATEWAY_HOST=0.0.0.0
DJI_GATEWAY_PORT=8000
# URL the standalone Telegram bot (dji-telegram) uses to reach the station
DJI_GATEWAY_URL=http://127.0.0.1:8000

# --- Flight safety caps (non-negotiable) ---------------------------------------
DJI_INDOOR_MAX_SPEED=1.0
DJI_INDOOR_MAX_ALTITUDE=3.0
DJI_INDOOR_MAX_BOX=15.0
DJI_OUTDOOR_MAX_SPEED=3.0
DJI_OUTDOOR_MAX_ALTITUDE=30.0
# local_polygon in metres, takeoff point = (0,0); the default is a 15 m box centred on takeoff
DJI_GEOFENCE_FILE=config/geofence_default.json

# --- Safety loop ---------------------------------------------------------------
DJI_WATCHDOG_TIMEOUT_MS=500
DJI_VIDEO_STALE_THRESHOLD_MS=1000
DJI_STICK_LOOP_FREQ_HZ=15
DJI_TOKEN_TTL_SECONDS=30

# --- 3D scanner (or pass --enable-3d to dji-station / --enable-3d-modeling to dji-ground)
DJI_ENABLE_3D_MODELING=false
# high | medium | low
DJI_MODEL_3D_RESOLUTION=high
DJI_MODEL_3D_KEYFRAME_MS=250
DJI_MODEL_3D_MAX_POINTS=500000
DJI_MODEL_3D_EXPORT_DIR=data/models_3d

# --- Object detector (needs: uv pip install -e ".[vision]") --------------------
DJI_ENABLE_YOLO=false

# --- Venice AI (scene captions, Telegram copilot, Hermes inference) ------------
# Key: https://venice.ai/settings/api
VENICE_API_KEY=your_venice_api_key_here
VENICE_API_BASE=https://api.venice.ai/api/v1
VENICE_MODEL=llama-3.3-70b
# Must be a vision-capable model id from https://api.venice.ai/api/v1/models
VENICE_VISION_MODEL=qwen3-vl-235b-a22b

# --- Telegram bot (dji-station --telegram, or dji-telegram) ---------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated numeric user ids (message @userinfobot). EMPTY = the bot refuses everyone.
TELEGRAM_ALLOWED_USERS=

# --- Live-flight clearances for scripts/indoor_mission.py & outdoor_mission.py --
INDOOR_ARM=0
OUTDOOR_ARM=0
