# ==============================================================================
# dji-ground Configuration Template
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# ==============================================================================

# Flight Authority & Bridge Settings
DJI_BRIDGE_HOST=127.0.0.1
DJI_TELEMETRY_PORT=8001
DJI_VIDEO_PORT=8002
DJI_COMMAND_PORT=8003
DJI_BRIDGE_MODE=fake             # "fake" for CI/tests, "opendji" for physical bridge

# Flight Safety Caps
DJI_INDOOR_MAX_SPEED=1.0         # m/s
DJI_INDOOR_MAX_ALTITUDE=3.0      # m AGL
DJI_INDOOR_MAX_BOX=15.0          # m
DJI_OUTDOOR_MAX_SPEED=3.0        # m/s
DJI_OUTDOOR_MAX_ALTITUDE=30.0    # m AGL
DJI_GEOFENCE_FILE=fixtures/geofence_sample.json

# Safety Loop & Watchdog
DJI_WATCHDOG_TIMEOUT_MS=500
DJI_VIDEO_STALE_THRESHOLD_MS=1000
DJI_STICK_LOOP_FREQ_HZ=15
DJI_TOKEN_TTL_SECONDS=30

# 3D Modeling & Live Reconstruction Feature
DJI_ENABLE_3D_MODELING=false      # Set to true or pass --enable-3d-modeling
DJI_MODEL_3D_RESOLUTION=high     # high, medium, low
DJI_MODEL_3D_KEYFRAME_MS=250
DJI_MODEL_3D_MAX_POINTS=500000
DJI_MODEL_3D_EXPORT_DIR=./data/models_3d

# Venice AI API (Inference for Hermes Agent)
VENICE_API_KEY=your_venice_api_key_here
VENICE_API_BASE=https://api.venice.ai/api/v1
VENICE_MODEL=llama-3.3-70b
VENICE_VISION_MODEL=qwen-2.5-vl-72b

# Telegram Bot Bridge
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALLOWED_USERS=123456789,987654321

# Opt-in Flight Safety Clearances (Must be explicitly set to 1 for live missions)
INDOOR_ARM=0
OUTDOOR_ARM=0
